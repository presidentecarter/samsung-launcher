# Copy to tv.env and set your values. tv.env is gitignored.
# Find your PC's LAN IP: hostname -I   (Linux/macOS: ipconfig getifaddr en0)

TV_IP=192.168.1.25
# Tizen Studio install path (created by tools/setup-tizen.sh)
TIZEN_STUDIO=$HOME/tizen-studio
# Security profile name created in Certificate Manager; must exist before first deploy
CERT_PROFILE=SamsungCert
